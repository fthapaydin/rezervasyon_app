# ----------------------------------------------------------------------
# Fizyotim — Apache Web Server Konfigürasyonu (.htaccess)
# ----------------------------------------------------------------------

# 1. UTF-8 Karakter Desteği
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .svg .xml

# 2. MIME Tipleri
<IfModule mod_mime.c>
  AddType application/javascript          js mjs
  AddType text/css                        css
  AddType image/svg+xml                   svg svgz
  AddType application/json                json
  AddType font/woff2                      woff2
  AddType font/woff                       woff
  AddType font/ttf                        ttf
  AddType image/webp                      webp
</IfModule>

# 3. SPA Yönlendirme (Single Page Application URL Rewrite)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Var olan fiziksel dosya veya dizin ise doğrudan sun
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # Kalan tüm istekleri index.html'e aktar (SPA Routing)
  RewriteRule ^ index.html [L]
</IfModule>

# 4. Özel 404 Hata Sayfası
ErrorDocument 404 /404.html

# 5. Güvenlik Başlıkları (Security Headers)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. GZIP / Deflate Sıkıştırma (Performans & Hızlı Yükleme)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/woff
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# 7. Tarayıcı Önbellekleme (Browser Cache / Expires)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML dosyaları her zaman güncel kontrol edilsin
  ExpiresByType text/html "access plus 0 seconds"

  # Statik Varlıklar (Hash'li JS, CSS, Fontlar)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
